# ─── تنظیمات پایه (برای شروع سریع روی ویندوز) ─────────────────────────────
SECRET_KEY=dev-secret-key-change-this-in-production-abcdef123456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── دیتابیس ──────────────────────────────────────────────────────────────────
# SQLite فعال است (نیاز به نصب ندارد)
USE_POSTGRES=False

# برای PostgreSQL این را True کنید و مقادیر زیر را پر کنید:
# USE_POSTGRES=True
# DB_NAME=cctv_shop_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# ─── CORS (فرانت‌اند) ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── ایمیل (در dev فقط در کنسول نمایش می‌دهد) ──────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ADMIN_EMAIL=admin@example.com

# ─── درگاه پرداخت (بعداً پر کنید) ────────────────────────────────────────────
BEHPARDAKHT_TERMINAL_ID=
BEHPARDAKHT_USERNAME=
BEHPARDAKHT_PASSWORD=
BEHPARDAKHT_CALLBACK_URL=http://localhost:3000/payment/success

# ─── redirect بعد از پرداخت ────────────────────────────────────────────────
FRONTEND_SUCCESS_URL=http://localhost:3000/payment/success
FRONTEND_FAILURE_URL=http://localhost:3000/payment/failure

# ─── تنظیمات کسب‌وکار ──────────────────────────────────────────────────────
LOW_STOCK_THRESHOLD=5
RESERVATION_DURATION_MINUTES=120
ADMIN_CONFIRM_DEADLINE_MINUTES=15
