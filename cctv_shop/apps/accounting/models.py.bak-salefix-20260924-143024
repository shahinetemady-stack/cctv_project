def generate_invoice_number():
    """شماره فاکتور فروش — ساده و ترتیبی، شروع از ۱۰۰۰ (فاکتورهای قدیمی با فرمت INV نادیده گرفته می‌شوند)"""
    from django.db.models.functions import Cast
    last = (
        SaleInvoice.objects
        .filter(invoice_number__regex=r'^\d+$')
        .annotate(num=Cast('invoice_number', models.BigIntegerField()))
        .order_by('-num')
        .values_list('num', flat=True)
        .first()
    )
    return str((last or 999) + 1)


