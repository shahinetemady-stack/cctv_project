"""
apps/accounting/models.py — v4
─────────────────────────────────
Workflow دو مرحله‌ای فاکتور خرید:

مرحله ۱ — ORDERED (هنگام ثبت سفارش):
  - supplier, items, نرخ یوان خرید
  - shipping_contact (شرکت حمل) — از همان ابتدا مشخص است
  - warehouse_transit (انبار در راه — مثلاً «در راه هوایی»)
  - apply_to_inventory(): موجودی به stock_quantity اضافه می‌شود
    + کاردکس انبار در راه: PURCHASE

مرحله ۲ — RECEIVED (وقتی کالا رسید):
  - rate_shipping_cny, shipping_cost_cny, clearance_cost_irr, carton_weight
  - warehouse_destination (انبار مقصد — shop1/shop2/...)
  - mark_received(): انتقال از warehouse_transit به warehouse_destination
    + کاردکس: TRANSFER_OUT از در راه + TRANSFER_IN به مقصد
    + stock_quantity تغییر نمی‌کند (از قبل اضافه شده)
"""
import logging
from django.db import models, transaction
from django.conf import settings
from django.utils import timezone
from decimal import Decimal

from apps.core.models import AuditMixin, AuditableModel

logger = logging.getLogger(__name__)


