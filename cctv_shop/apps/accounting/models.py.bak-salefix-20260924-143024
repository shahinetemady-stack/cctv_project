        VIRTUAL   = "virtual",   "کیف پول / ارزی"

    class Currency(models.TextChoices):
        IRR = "IRR", "ریال"
        CNY = "CNY", "یوان"
        USD = "USD", "دلار"

    name         = models.CharField(max_length=100)
    account_type = models.CharField(max_length=20, choices=AccountType.choices)
    currency     = models.CharField(max_length=5, choices=Currency.choices, default=Currency.IRR)
    bank_name    = models.CharField(max_length=100, blank=True)
    account_number = models.CharField(max_length=50, blank=True)
    initial_balance = models.DecimalField(max_digits=18, decimal_places=2, default=0)
    is_active    = models.BooleanField(default=True)
    note         = models.TextField(blank=True)
    created_at   = models.DateTimeField(auto_now_add=True)
    updated_at   = models.DateTimeField(auto_now=True)

    class Meta:
        db_table = "accounting_account"
        verbose_name = "حساب بانکی / صندوق"
        verbose_name_plural = "حساب‌های بانکی / صندوق"
        ordering = ["name"]

    def __str__(self):
        return f"{self.name} ({self.get_account_type_display()}) — {self.currency}"

    @property
    def balance(self):
        """
        موجودی حساب = مانده اولیه + ورودی‌ها - خروجی‌ها.
        اگر ارز تراکنش با ارز حساب فرق داشته باشد، معادل ریالی (amount_irr)
        برای حساب‌های ریالی و معادل ارز حساب برای حساب‌های ارزی لحاظ می‌شود.
        """
        def eff(p):
            if p.currency == self.currency:
                return float(p.amount)
            if self.currency == 'IRR':
                return float(p.amount_irr)
            # حساب ارزی با تراکنش ریالی — تبدیل با همان نرخ
            return round(float(p.amount_irr) / float(p.rate_irr), 2) if p.rate_irr else float(p.amount)

        paid_out = sum(eff(p) for p in self.payments_out.all())
        paid_in = sum(eff(p) for p in self.payments_in.all())
        total = float(self.initial_balance) + paid_in - paid_out
        # دریافتی‌های فاکتور فروش (SalePayment) همیشه ریالی است
        if self.currency == 'IRR':
            from django.db.models import Sum
            sale_in = self.sale_receipts.aggregate(s=Sum('amount'))['s'] or 0
            total += float(sale_in)
        return total


