def generate_return_number():
    """شماره سند برگشت — سکانس عددی جدا، شروع از ۱۰۰۰"""
    from django.db.models.functions import Cast
    last = (
        ReturnInvoice.objects
        .filter(invoice_number__regex=r'^\d+$')
        .annotate(num=Cast('invoice_number', models.BigIntegerField()))
        .order_by('-num')
        .values_list('num', flat=True)
        .first()
    )
    return str((last or 999) + 1)


class ReturnInvoice(AuditMixin):
    """
    سند برگشت:
    - برگشت از فروش: کالا از مشتری برمی‌گردد → ورود به انبار (+) با حرکت RETURN
    - برگشت از خرید: کالا به تأمین‌کننده برمی‌گردد → خروج از انبار (−) با حرکت RETURN
    موجودی هنگام ثبت سند اعمال می‌شود (مثل فاکتور فروش/خرید دستی) و با لغو سند معکوس می‌شود.
    """
    class ReturnType(models.TextChoices):
        SALE     = "sale",     "برگشت از فروش"
        PURCHASE = "purchase", "برگشت از خرید"

    class Status(models.TextChoices):
        CONFIRMED = "confirmed", "ثبت شده"
        CANCELLED = "cancelled", "لغو شده"

    return_type  = models.CharField(max_length=10, choices=ReturnType.choices, verbose_name="نوع برگشت")
    invoice_number = models.CharField(max_length=50, unique=True, default=generate_return_number)
    sale_invoice = models.ForeignKey(SaleInvoice, on_delete=models.SET_NULL,
                        null=True, blank=True, related_name='returns', verbose_name="فاکتور فروش مبدأ")
    purchase_invoice = models.ForeignKey(PurchaseInvoice, on_delete=models.SET_NULL,
                        null=True, blank=True, related_name='returns', verbose_name="فاکتور خرید مبدأ")
    warehouse  = models.ForeignKey('inventory.Warehouse', on_delete=models.PROTECT,
                        related_name='return_invoices', verbose_name="انبار")
    date       = models.DateField(verbose_name="تاریخ")
    note       = models.TextField(blank=True)
    status     = models.CharField(max_length=20, choices=Status.choices, default=Status.CONFIRMED)
    inventory_applied = models.BooleanField(default=False)
    created_by = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.SET_NULL,
                        null=True, blank=True, related_name='created_returns')
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    updated_by = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.SET_NULL,
                        null=True, blank=True, related_name='edited_returns',
                        verbose_name="آخرین ویرایش‌کننده")

    class Meta:
        db_table = "accounting_return_invoice"
        verbose_name = "سند برگشت"
        verbose_name_plural = "اسناد برگشت"
        ordering = ["-created_at"]

    def __str__(self):
        return f"برگشت {self.invoice_number} — {self.get_return_type_display()}"

    @property
    def total_amount(self):
        return sum(item.subtotal for item in self.items.all())

    @transaction.atomic
    def apply_to_inventory(self, user=None):
        """اعمال موجودی هنگام ثبت سند — idempotent با فلگ inventory_applied"""
        if self.inventory_applied:
            return False
        items = list(self.items.select_related("variant").all())
        if not items:
            raise ValueError("این سند آیتمی ندارد.")

        from apps.inventory.models import StockMovement
        is_sale_return = self.return_type == self.ReturnType.SALE

        if not is_sale_return:
            for item in items:
                if item.variant.stock_quantity < item.quantity:
                    raise ValueError(
                        f"موجودی کافی برای برگشت '{item.variant.sku}' وجود ندارد. "
                        f"موجود: {item.variant.stock_quantity} | لازم: {item.quantity}"
                    )

        for item in items:
            if is_sale_return:
                item.variant.stock_quantity += item.quantity
            else:
                item.variant.stock_quantity -= item.quantity
            item.variant.save(update_fields=["stock_quantity"])
            StockMovement.record(
                warehouse=self.warehouse,
                variant=item.variant,
                movement_type=StockMovement.MovementType.RETURN,
                quantity=item.quantity if is_sale_return else -item.quantity,
                unit_price=int(item.unit_price),
                reference=self.invoice_number,
                note=f"{self.get_return_type_display()} — سند {self.invoice_number}",
                user=user,
            )

        self.inventory_applied = True
        self.save(update_fields=["inventory_applied", "updated_at"])
        return True

    @transaction.atomic
    def cancel(self, user=None):
        """لغو سند و معکوس‌کردن حرکت‌های موجودی"""
        if self.status == self.Status.CANCELLED:
            return False

        from apps.inventory.models import StockMovement
        is_sale_return = self.return_type == self.ReturnType.SALE

        for item in self.items.select_related("variant").all():
            if is_sale_return:
                if item.variant.stock_quantity < item.quantity:
                    raise ValueError(
                        f"امکان لغو نیست — موجودی '{item.variant.sku}' کمتر از مقدار برگشتی است."
                    )
                item.variant.stock_quantity -= item.quantity
            else:
                item.variant.stock_quantity += item.quantity
            item.variant.save(update_fields=["stock_quantity"])
            StockMovement.record(
                warehouse=self.warehouse,
                variant=item.variant,
                movement_type=StockMovement.MovementType.RETURN,
                quantity=-item.quantity if is_sale_return else item.quantity,
                unit_price=int(item.unit_price),
                reference=self.invoice_number,
                note=f"لغو {self.get_return_type_display()} — سند {self.invoice_number}",
                user=user,
            )

        self.status = self.Status.CANCELLED
        self.save(update_fields=["status", "updated_at"])
        return True


