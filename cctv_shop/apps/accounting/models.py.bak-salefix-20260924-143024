        db_table = "accounting_sale_invoice"
        verbose_name = "فاکتور فروش"
        verbose_name_plural = "فاکتورهای فروش"
        ordering = ["-created_at"]

    def __str__(self):
        return f"فاکتور {self.invoice_number} — {self.customer_name or self.customer}"

    @property
    def subtotal(self):
        return sum(item.subtotal for item in self.items.all())

    @property
    def total_amount(self):
        return self.subtotal - self.discount_amount + self.shipping_cost + self.tax_amount

    @property
    def paid_amount(self):
        from django.db.models import Sum
        return self.sale_payments.aggregate(s=Sum('amount'))['s'] or 0

    @property
    def remaining_amount(self):
        return self.total_amount - self.paid_amount

    @property
    def total_cost(self):
        return sum(item.total_cost for item in self.items.all())

    @property
    def gross_profit(self):
        return self.total_amount - self.total_cost

    @transaction.atomic
    def deduct_from_inventory(self, user=None):
        if self.stock_deducted:
            return False
        if self.source == self.InvoiceSource.ORDER:
            self.stock_deducted = True
            self.save(update_fields=["stock_deducted", "updated_at"])
            return False

        items = list(self.items.select_related("variant").all())
        if not items:
            raise ValueError("این فاکتور آیتمی ندارد.")

        for item in items:
            if item.variant.available_stock < item.quantity:
                raise ValueError(
                    f"موجودی کافی برای '{item.variant.sku}' وجود ندارد. "
                    f"موجود: {item.variant.available_stock} | لازم: {item.quantity}"
                )

        for item in items:
            item.variant.deduct_stock(item.quantity)
            self._record_warehouse_outflow(item, user)

        self.stock_deducted = True
        self.save(update_fields=["stock_deducted", "updated_at"])
        return True

    def _record_warehouse_outflow(self, item, user=None):
        try:
            from apps.inventory.models import Warehouse, StockMovement
            warehouse = (
                Warehouse.objects.filter(is_public=True, is_active=True).first()
                or Warehouse.objects.filter(is_active=True).first()
            )
            if warehouse is None:
                return
            StockMovement.record(
                warehouse=warehouse,
                variant=item.variant,
                movement_type=StockMovement.MovementType.SALE,
                quantity=-item.quantity,
                unit_price=int(item.unit_price),
                reference=self.invoice_number,
                note=f"فروش دستی — فاکتور {self.invoice_number}",
                user=user,
            )
        except Exception as exc:
            logger.warning(f"[INVENTORY] ثبت کاردکس فروش ناموفق: {exc}")


