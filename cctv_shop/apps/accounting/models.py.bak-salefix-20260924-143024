        SalePayment, on_delete=models.SET_NULL,
        null=True, blank=True, related_name="receipts", verbose_name="پرداخت فروش",
    )

    class Meta:
        db_table = "accounting_payment_receipt"
        verbose_name = "فیش واریزی"
        verbose_name_plural = "فیش‌های واریزی"
        ordering = ["-created_at"]

    def __str__(self):
        return f"فیش {self.order.order_number} | {self.amount:,} ریال [{self.get_status_display()}]"

    def _image_changed(self) -> bool:
        """True اگر آپلود جدید است یا تصویر نسبت به رکورد قبلی عوض شده."""
        if not self.image:
            return False
        if not self.pk:
            return True
        try:
            old = PaymentReceipt.objects.only("image").get(pk=self.pk)
        except PaymentReceipt.DoesNotExist:
            return True
        return old.image.name != self.image.name

    def save(self, *args, **kwargs):
        if self._image_changed():
            try:
                from io import BytesIO
                import os
                from PIL import Image as PILImage
                from django.core.files.base import ContentFile

                img = PILImage.open(self.image)
                img = img.convert("RGB")
                if img.width > 1200:
                    ratio = 1200 / img.width
                    img = img.resize((1200, int(img.height * ratio)), PILImage.LANCZOS)
                buffer = BytesIO()
                img.save(buffer, format="WEBP", quality=80)
                stem = os.path.splitext(os.path.basename(self.image.name))[0]
                self.image.save(f"{stem}.webp", ContentFile(buffer.getvalue()), save=False)
            except Exception as exc:
                logger.warning(f"[RECEIPT] فشرده‌سازی تصویر فیش ناموفق: {exc}")
        super().save(*args, **kwargs)


