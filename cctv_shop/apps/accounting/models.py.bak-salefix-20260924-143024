    @property
    def balance_irr(self):
        """
        مانده حساب به ریال — فقط اسناد ریالی خالص.
        اسناد یوانی در balance_cny حساب می‌شوند و «مانده کل» =
        balance_irr + balance_cny × نرخ روز یوان است.
        مثبت = طرف حساب به ما بدهکار است (بستانکار ما)
        منفی = ما به طرف حساب بدهکاریم
        """
        from django.db.models import Sum
        paid_irr = self.payments.filter(currency='IRR', direction='out').aggregate(s=Sum('amount'))['s'] or 0
        recv_irr = self.payments.filter(currency='IRR', direction='in').aggregate(s=Sum('amount'))['s'] or 0

        total_invoiced_irr = 0
        for inv in self.purchase_invoices.all():
            if inv.purchase_type == PurchaseInvoice.PurchaseType.DOMESTIC:
                # خرید داخلی — قیمت آیتم‌ها مستقیماً ریال است
                total_invoiced_irr += sum(item.unit_price_irr * item.quantity for item in inv.items.all())

        for inv in self.shipping_invoices.all():
            total_invoiced_irr += inv.clearance_cost_irr

        extra_irr = self.extra_costs.aggregate(s=Sum('amount_irr'))['s'] or 0
        total_invoiced_irr += extra_irr

        # ما کالا خریدیم = به تأمین‌کننده بدهکاریم = balance منفی
        # پول دادیم (out) = بدهی کم شد = balance مثبت | از او گرفتیم (in) = balance منفی‌تر
        # مانده اول دوره: مثبت = بدهکار به ما، منفی = بستانکار
        return float(paid_irr) - float(recv_irr) - total_invoiced_irr + float(self.opening_balance_irr)

    @property
    def balance_cny(self):
        """
        مانده حساب به یوان.
        مثبت = طرف حساب به ما بدهکار است (بستانکار ما)
        منفی = ما به طرف حساب بدهکاریم
        """
        from django.db.models import Sum
        paid_cny = self.payments.filter(currency='CNY', direction='out').aggregate(s=Sum('amount'))['s'] or 0
        recv_cny = self.payments.filter(currency='CNY', direction='in').aggregate(s=Sum('amount'))['s'] or 0
        total_paid_cny = float(paid_cny)
        total_cny = 0
        for inv in self.purchase_invoices.all():
            items_cny = sum(float(item.unit_price_cny) * item.quantity for item in inv.items.all())
            total_cny += items_cny
        for inv in self.shipping_invoices.all():
            total_cny += float(inv.shipping_cost_cny)

        # ما کالا خریدیم = به تأمین‌کننده بدهکاریم = balance منفی
        # پول دادیم (out) = بدهی کم شد = balance مثبت | از او گرفتیم (in) = balance منفی‌تر
        # مانده اول دوره: مثبت = بدهکار به ما، منفی = بستانکار
        return total_paid_cny - float(recv_cny) - total_cny + float(self.opening_balance_cny)


class PurchaseInvoice(AuditMixin):
    """فاکتور خرید — workflow دو مرحله‌ای با انبار در راه/مقصد (خارجی) یا رسید مستقیم (داخلی)"""

    class PurchaseType(models.TextChoices):
        FOREIGN  = "foreign",  "خرید خارجی"
        DOMESTIC = "domestic", "خرید داخلی"

    class Status(models.TextChoices):
        ORDERED   = "ordered",   "سفارش داده شده (در راه)"
        RECEIVED  = "received",  "رسیده (در انبار)"
        PAID      = "paid",      "تسویه شده"
        CANCELLED = "cancelled", "لغو شده"

    purchase_type  = models.CharField(max_length=10, choices=PurchaseType.choices,
                        default=PurchaseType.FOREIGN, verbose_name="نوع خرید")
    supplier       = models.ForeignKey(Contact, on_delete=models.PROTECT,
                        related_name="purchase_invoices", verbose_name="تامین‌کننده")
    invoice_number = models.CharField(max_length=50, blank=True, verbose_name="شماره فاکتور")
    date           = models.DateField(verbose_name="تاریخ سفارش")

    # ── انبار در راه (مرحله ۱) ───────────────────────────────
    warehouse      = models.ForeignKey("inventory.Warehouse", on_delete=models.PROTECT,
                        null=True, blank=True,
                        related_name="purchase_invoices_transit",
                        verbose_name="انبار در راه")

    # ── انبار مقصد (مرحله ۲) ───────────────────────────────
    warehouse_destination = models.ForeignKey(
        "inventory.Warehouse", on_delete=models.PROTECT,
        null=True, blank=True,
        related_name="purchase_invoices_destination",
        verbose_name="انبار مقصد (وقتی رسید)")

    rate_purchase_cny = models.PositiveBigIntegerField(
        verbose_name="نرخ یوان خرید (تومان)")
    rate_shipping_cny = models.PositiveBigIntegerField(
        default=0, null=True, blank=True,
        verbose_name="نرخ یوان حمل (تومان)")

    # شرکت حمل — از مرحله ۱ قابل تعیین است
    shipping_contact   = models.ForeignKey(Contact, on_delete=models.SET_NULL,
                            null=True, blank=True, related_name="shipping_invoices",
                            verbose_name="شرکت حمل / ترخیص‌کار")
    shipping_cost_cny  = models.DecimalField(max_digits=12, decimal_places=2, default=0,
                            verbose_name="هزینه حمل کل (یوان)")
    clearance_cost_irr = models.PositiveBigIntegerField(default=0,
                            verbose_name="هزینه ترخیص کل (ریال)")

    status     = models.CharField(max_length=20, choices=Status.choices,
                    default=Status.ORDERED, verbose_name="وضعیت")
    note       = models.TextField(blank=True, verbose_name="توضیحات")

    received_at = models.DateTimeField(null=True, blank=True, verbose_name="تاریخ رسیدن کالا")
    inventory_applied = models.BooleanField(default=False, verbose_name="موجودی اعمال شده")
    inventory_applied_at = models.DateTimeField(null=True, blank=True)

    created_by = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.SET_NULL,
                    null=True, blank=True, related_name="created_purchase_invoices",
                    verbose_name="ثبت‌کننده")
    received_by = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.SET_NULL,
                    null=True, blank=True, related_name="received_purchase_invoices",
                    verbose_name="تأییدکننده رسیدن کالا")
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    updated_by = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.SET_NULL,
                    null=True, blank=True, related_name="edited_purchase_invoices",
                    verbose_name="آخرین ویرایش‌کننده")

    class Meta:
        db_table = "accounting_purchase_invoice"
        verbose_name = "فاکتور خرید"
        verbose_name_plural = "فاکتورهای خرید"
        ordering = ["-date", "-created_at"]

    def __str__(self):
        return f"فاکتور {self.invoice_number or self.id} — {self.supplier.name} — {self.date}"

    @property
    def total_weight(self):
        return sum(item.total_weight for item in self.items.all())

    @property
    def total_cny(self):
        items_cny = sum(item.subtotal_cny for item in self.items.all())
        return items_cny + (self.shipping_cost_cny or 0)

    @property
    def total_irr(self):
        # خرید داخلی — قیمت‌ها مستقیماً ریال است
        if self.purchase_type == self.PurchaseType.DOMESTIC:
            items_irr = sum(item.unit_price_irr * item.quantity for item in self.items.all())
            extra_irr = sum(e.amount_irr for e in self.extra_costs.all())
            return int(items_irr + extra_irr)
        items_irr = sum(item.subtotal_cny * self.rate_purchase_cny for item in self.items.all())
        # اگه rate_shipping_cny ثبت نشده، از rate_purchase_cny استفاده می‌کنیم
        shipping_rate = self.rate_shipping_cny or self.rate_purchase_cny or 0
        shipping_irr = (self.shipping_cost_cny or 0) * shipping_rate
        extra_irr = sum(e.amount_irr for e in self.extra_costs.all())
        return int(items_irr + shipping_irr + (self.clearance_cost_irr or 0) + extra_irr)

    @property
    def is_complete(self):
        return bool(self.rate_shipping_cny and self.total_weight)

    def calculate_items_cost(self):
        """محاسبه بهای تمام شده هر آیتم"""
        total_w = self.total_weight
        for item in self.items.all():
            if total_w > 0:
                weight_ratio = Decimal(str(item.total_weight)) / Decimal(str(total_w))
            else:
                weight_ratio = Decimal('0')

            shipping_irr = (self.shipping_cost_cny or Decimal('0')) * Decimal(str(self.rate_shipping_cny or 0)) * weight_ratio
            item.shipping_cost_irr = int(shipping_irr / item.quantity) if item.quantity else 0

            clearance_share = Decimal(str(self.clearance_cost_irr or 0)) * weight_ratio
            item.clearance_cost_irr = int(clearance_share / item.quantity) if item.quantity else 0

            extra_total = sum(e.amount_irr for e in self.extra_costs.all())
            extra_share = Decimal(str(extra_total)) * weight_ratio
            item.extra_cost_irr = int(extra_share / item.quantity) if item.quantity else 0

            purchase_irr = item.unit_price_cny * Decimal(str(self.rate_purchase_cny))
            item.unit_cost_irr = int(
                purchase_irr +
                item.shipping_cost_irr +
                item.clearance_cost_irr +
                item.extra_cost_irr
            )
            item.save()

    # ═══════════════════════════════════════════════════════════════════
    # مرحله ۱: apply_to_inventory — وقتی سفارش ثبت می‌شود
    # ═══════════════════════════════════════════════════════════════════
    @transaction.atomic
    def apply_to_inventory(self, user=None):
        """
        موجودی را به انبار «در راه» (self.warehouse) اضافه می‌کند:
          - stock_quantity += quantity  (از نظر مالی، کالا خریداری شده)
          - WarehouseStock انبار در راه += quantity
          - کاردکس: PURCHASE در انبار در راه
        idempotent
        """
        from django.utils import timezone

        if self.inventory_applied:
            return False

        items = list(self.items.select_related("variant").all())
        if not items:
            raise ValueError("این فاکتور آیتمی ندارد.")

        for item in items:
            variant = item.variant
            old_qty = variant.stock_quantity
            variant.stock_quantity = old_qty + item.quantity
            variant.save(update_fields=["stock_quantity"])
            logger.info(
                f"[PURCHASE] {variant.sku}: {old_qty} → {variant.stock_quantity} "
                f"(+{item.quantity}) فاکتور {self.invoice_number or self.id}"
            )

            if self.warehouse is not None:
                self._record_warehouse_inflow(item, user)

        self.inventory_applied = True
        self.inventory_applied_at = timezone.now()
        self.save(update_fields=["inventory_applied", "inventory_applied_at", "updated_at"])
        return True

    def _record_warehouse_inflow(self, item, user=None):
        """ثبت ورود به انبار در راه (مرحله ۱)"""
        try:
            from apps.inventory.models import StockMovement
            StockMovement.record(
                warehouse=self.warehouse,
                variant=item.variant,
                movement_type=StockMovement.MovementType.PURCHASE,
                quantity=item.quantity,
                unit_price=int(item.unit_cost_irr or 0),
                reference=self.invoice_number or str(self.id),
                note=f"خرید از {self.supplier.name} → {self.warehouse.name}",
                user=user,
            )
        except Exception as exc:
            logger.warning(f"[INVENTORY] ثبت کاردکس inflow ناموفق: {exc}")

    # ═══════════════════════════════════════════════════════════════════
    # مرحله ۲: mark_received — وقتی کالا می‌رسد و به انبار مقصد منتقل می‌شود
    # ═══════════════════════════════════════════════════════════════════
    @transaction.atomic
    def mark_received(self, destination_warehouse, user=None):
        """
        هنگام رسیدن کالا:
          1) ذخیره انبار مقصد
          2) محاسبه بهای تمام شده (با اطلاعات حمل تکمیل شده)
          3) انتقال از انبار در راه → انبار مقصد در کاردکس:
             - TRANSFER_OUT از در راه (-quantity)
             - TRANSFER_IN به مقصد (+quantity)
          4) stock_quantity تغییر نمی‌کند (در مرحله ۱ اضافه شده بود)

        idempotent: اگر status == RECEIVED، چیزی نمی‌کند
        """
        from django.utils import timezone

        if self.status == self.Status.RECEIVED:
            logger.info(f"[PURCHASE] فاکتور {self.invoice_number or self.id} قبلاً RECEIVED شده")
            return False

        if destination_warehouse is None:
            raise ValueError("انبار مقصد الزامی است.")

        self.warehouse_destination = destination_warehouse

        items = list(self.items.select_related("variant").all())
        if not items:
            raise ValueError("این فاکتور آیتمی ندارد.")

        # محاسبه بهای تمام شده
        self.calculate_items_cost()

        # انتقال موجودی از انبار در راه به انبار مقصد
        if self.warehouse and destination_warehouse and self.warehouse_id != destination_warehouse.id:
            for item in items:
                self._record_warehouse_transfer(item, destination_warehouse, user)

        self.status = self.Status.RECEIVED
        self.received_at = timezone.now()
        if user:
            self.received_by = user
        self.save(update_fields=[
            "status", "warehouse_destination", "received_at", "received_by", "updated_at",
        ])
        return True

    def _record_warehouse_transfer(self, item, destination, user=None):
        """انتقال یک آیتم از انبار در راه → انبار مقصد در کاردکس"""
        try:
            from apps.inventory.models import StockMovement
            # خروج از انبار در راه
            StockMovement.record(
                warehouse=self.warehouse,
                variant=item.variant,
                movement_type=StockMovement.MovementType.TRANSFER_OUT,
                quantity=-item.quantity,
                unit_price=int(item.unit_cost_irr or 0),
                reference=self.invoice_number or str(self.id),
                note=f"رسیدن کالا → انتقال به {destination.name}",
                user=user,
            )
            # ورود به انبار مقصد
            StockMovement.record(
                warehouse=destination,
                variant=item.variant,
                movement_type=StockMovement.MovementType.TRANSFER_IN,
                quantity=item.quantity,
                unit_price=int(item.unit_cost_irr or 0),
                reference=self.invoice_number or str(self.id),
                note=f"رسیدن از {self.warehouse.name if self.warehouse else 'در راه'}",
                user=user,
            )
        except Exception as exc:
            logger.warning(f"[INVENTORY] انتقال انبار ناموفق: {exc}")


class PurchaseItem(models.Model):
    invoice  = models.ForeignKey(PurchaseInvoice, on_delete=models.CASCADE,
                  related_name="items", verbose_name="فاکتور")
    variant  = models.ForeignKey("catalog.ProductVariant", on_delete=models.PROTECT,
                  related_name="purchase_items", verbose_name="کالا")

    quantity        = models.PositiveIntegerField(verbose_name="تعداد کل")
    carton_count    = models.PositiveIntegerField(default=1, verbose_name="تعداد کارتن")
    carton_weight   = models.DecimalField(max_digits=8, decimal_places=3,
                        null=True, blank=True, default=0,
                        verbose_name="وزن هر کارتن (kg)")

    unit_price_cny  = models.DecimalField(max_digits=10, decimal_places=2, default=0,
                        verbose_name="قیمت واحد (یوان)")
    unit_price_irr  = models.PositiveBigIntegerField(default=0,
                        verbose_name="قیمت واحد (ریال) — خرید داخلی")

    shipping_cost_irr  = models.PositiveBigIntegerField(default=0)
    clearance_cost_irr = models.PositiveBigIntegerField(default=0)
    extra_cost_irr     = models.PositiveBigIntegerField(default=0)
    unit_cost_irr      = models.PositiveBigIntegerField(default=0)

    note = models.CharField(max_length=200, blank=True)

    class Meta:
        db_table = "accounting_purchase_item"
        verbose_name = "آیتم فاکتور خرید"
        verbose_name_plural = "آیتم‌های فاکتور خرید"

    def __str__(self):
        return f"{self.variant} × {self.quantity}"

    @property
    def total_weight(self):
        if not self.carton_weight:
            return 0
        return float(self.carton_weight) * self.carton_count

    @property
    def subtotal_cny(self):
        return self.unit_price_cny * self.quantity


class ExtraCost(models.Model):
    class CostType(models.TextChoices):
        RENT       = "rent",       "اجاره"
        DELIVERY   = "delivery",   "پیک / ارسال"
        COMMISSION = "commission", "پورسانت فروش"
