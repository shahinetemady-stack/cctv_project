const toToman = irr => Math.round(Number(irr || 0) / 10).toLocaleString('fa-IR');

// جستجوی هوشمند سایت — کلمات محاوره‌ای و مترادف‌ها را خودش هندل می‌کند
async function searchProducts(q) {
  const res = await fetch(`${SITE}/api/catalog/products/search/?q=${encodeURIComponent(q)}`, { signal: AbortSignal.timeout(FETCH_TIMEOUT) });
  if (!res.ok) return [];
  const data = await res.json();
  return (data.results || []).slice(0, 8);
}

async function priceLookup(body) {
  if (!SHOP_TOKEN) return null;
  const res = await fetch(`${SITE}/api/core/bot/price/`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Bot-Token': SHOP_TOKEN },
    signal: AbortSignal.timeout(FETCH_TIMEOUT),
    body: JSON.stringify(body),
  });
  if (!res.ok) return null;
  return res.json();
}

// امتیاز ارتباط نتیجه با کوئری — مدل/نام دقیق بالاتر از مچ در سنسور/کلمات‌کلیدی
function relevanceScore(p, q) {
  const esc = q.toLowerCase().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const tokRe = new RegExp(`(^|[^a-z0-9])${esc}([^a-z0-9]|$)`, 'i');
  const model = String(p.model_number || '').toLowerCase();
  const name = String(p.name || '').toLowerCase();
  const ql = q.toLowerCase();
  let s = 0;
  if (model === ql) s += 120;
  if (tokRe.test(model)) s += 80;
  else if (model.includes(ql)) s += 40;
  if (tokRe.test(name)) s += 30;
  else if (name.includes(ql)) s += 15;
  return s;
}

// مرتبط‌ترین محصول با پیام + قیمت واقعی‌اش → آبجکت کانتکست (برای Gemini و کارت محصول)
async function productContext(text) {
  let query = text;
  let results = await searchProducts(query).catch(() => []);
  // مدل‌هایی مثل K2K4 در سایت با اسلش ثبت شده‌اند (TF K2/K4B) → تلاش دوم با اسلش
  if (!results.length && /\d(?=[a-zA-Z])/.test(text)) {
    query = text.replace(/(\d)(?=[a-zA-Z])/g, '$1/');
    results = await searchProducts(query).catch(() => []);
  }
  if (!results.length) return null;
  let best = null, bestScore = 0;
  for (const p of results) { const s = relevanceScore(p, query); if (s > bestScore) { bestScore = s; best = p; } }
  if (bestScore < 40) {
    // کوئری فارسی محاوره‌ای: تطبیق توکن روی نام محصول
    const toks = text.split(/\s+/).filter(t => t.length >= 3);
    best = results.find(p => toks.some(t => String(p.name || '').includes(t))) || null;
  }
  if (!best) return null;
  const info = await priceLookup({ product_id: best.id }).catch(() => null);
  if (!info?.product) return null;
  const pr = info.product;
  return {
    name: pr.name,
    priceToman: toToman(info.price),
    inStock: !!pr.in_stock,
    url: pr.url,
    geminiLine: `محصول مرتبط در فروشگاه: ${pr.name} | قیمت عمومی: ${toToman(info.price)} تومان | موجودی: ${pr.in_stock ? 'موجود' : 'ناموجود'} | لینک: ${pr.url}`,
  };
}

// کارت محصول برای دایرکت — قیمت عمومی + دعوت به ثبت‌نام همکاری
function productCard(p) {
  return `📦 ${p.name}\n` +
    `💰 قیمت عمومی: ${p.priceToman} تومان\n` +
    `${p.inStock ? '✅ موجود' : '❌ ناموجود'}\n` +
    `🔗 ${p.url}\n` +
    `💼 جهت مشاهده قیمت ویژه همکاری، در سایت doorbinkar.com به‌عنوان همکار ثبت‌نام کنید.`;
}

// آیا متن حاوی کد قطعه است؟ (توکن لاتین/عددی با حداقل یک رقم — مثل 2053 یا F38 یا H5AI)
const faToEnDigits = s => s.replace(/[۰-۹٠-٩]/g, d => '۰۱۲۳۴۵۶۷۸۹٠١٢٣٤٥٦٧٨٩'.indexOf(d) % 10);
function extractProductCode(text) {
  const t = faToEnDigits(text);
  const m = t.match(/[A-Za-z0-9][A-Za-z0-9\-+]{1,19}/);
  return m && /\d/.test(m[0]) ? m[0] : null;
}

const sleep = ms => new Promise(r => setTimeout(r, ms));
const humanDelay = () => 3000 + Math.floor(Math.random() * 4000);

