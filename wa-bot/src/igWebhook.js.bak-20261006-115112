// فایل ig_gate.json کنار src/ — بدون ری‌استارت خوانده می‌شود.
// توجه: API رسمی متا راهی برای چک‌کردن «فالو بودن» کاربر نمی‌دهد؛ این دروازه مثل ابزارهای
// بازاریابی (ManyChat و…) بر اساس تأیید خود کاربر است (دکمه «فالو کردم»).
const GATE_FILE = path.join(__dirname, '..', 'ig_gate.json');
const Database = require('better-sqlite3');
const gateDb = new Database(path.join(__dirname, '..', 'data', 'bot.db'));
gateDb.exec('CREATE TABLE IF NOT EXISTS follow_gate (key TEXT PRIMARY KEY, status TEXT, pending TEXT, ts INTEGER)');
const gateUpsert = gateDb.prepare(`INSERT INTO follow_gate (key, status, pending, ts) VALUES (?, ?, ?, ?)
  ON CONFLICT(key) DO UPDATE SET status=excluded.status, pending=excluded.pending, ts=excluded.ts`);

const GATE_DEFAULTS = {
  enabled: true,
  profile_url: 'https://instagram.com/doorbinkar1/',
  follow_btn_title: 'فالو کردن پیج 💚',
  ask_text: 'ممنون میشم قبل ارسال لینک فالوم کنی 💚',
  ask_text_short: 'ممنون میشم قبل ارسال لینک فالوم کنی 💚',
  ask_text_comment: 'ممنون میشم قبل ارسال لینک فالوم کنی 💚 instagram.com/doorbinkar1 — بعد همینجا بنویس «فالو کردم».',
  confirm_title: 'فالو کردم',
  confirm_regex: 'فالو کردم',
  still_not_following_text: 'فالوت هنوز توی سیستم ثبت نشده 🙏 اگر تازه فالو کردی، چند لحظه صبر کن و دوباره دکمه رو بزن.',
  thanks_text: 'ممنون بابت فالو 💚 بفرما، چه قطعه‌ای برای مونتاژ لازم داری؟',
  confirmed_text: 'ممنون بابت فالو 💚',
};

function getGate() {
  try { return { ...GATE_DEFAULTS, ...JSON.parse(fs.readFileSync(GATE_FILE, 'utf8')) }; } catch { return GATE_DEFAULTS; }
}
const gateRow = key => gateDb.prepare('SELECT status, pending, ts FROM follow_gate WHERE key=?').get(key);
const gateStatus = jid => gateRow('ig:' + jid)?.status || 'none';
function gateSet(key, status, pendingArr) {
  gateUpsert.run(key, status, JSON.stringify(pendingArr), Date.now());
}
function pushPending(key, item) {
  const r = gateRow(key);
  const arr = r?.pending ? JSON.parse(r.pending) : [];
  arr.push(item);
  gateSet(key, r?.status || 'pending', arr);
}
function drainPending(key) {
  const r = gateRow(key);
  const arr = r?.pending ? JSON.parse(r.pending) : [];
  if (arr.length) gateSet(key, r?.status || 'pending', []);
  return arr;
}

function isGateConfirm(text, payload, gate) {
  if (payload === 'FOLLOW_OK') return true;
  try { return new RegExp(gate.confirm_regex || 'فالو کردم').test(text || ''); }
  catch { return (text || '').includes('فالو کردم'); }
}

// پروفایل کاربر از روی IGSID — username + وضعیت فالو واقعی (is_user_follow_business)
async function fetchProfile(igsid) {
  const res = await fetch(`${GRAPH_BASE}/${GRAPH_VERSION}/${igsid}?fields=username,is_user_follow_business&access_token=${PAGE_TOKEN}`, { signal: AbortSignal.timeout(FETCH_TIMEOUT) });
  if (!res.ok) return null;
  const j = await res.json();
  return { username: j.username || null, following: j.is_user_follow_business === true };
}

// پیام دروازه فالو در دایرکت: دکمه «فالو کردن پیج» (لینک پروفایل) + دکمه «فالو کردم» (Quick Reply)
// هیچ دکمه‌ای در API متا نمی‌تواند مستقیم فالو کند؛ دکمه لینک، پروفایل را باز می‌کند.
async function sendIgGateAsk(recipientId, text, gate) {
  if (!PAGE_TOKEN) throw new Error('IG_PAGE_TOKEN is not set');
  const send = message => fetch(`${GRAPH_BASE}/${GRAPH_VERSION}/me/messages?access_token=${PAGE_TOKEN}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ recipient: { id: recipientId }, message }),
  });
  const qr = [{ content_type: 'text', title: gate.confirm_title, payload: 'FOLLOW_OK' }];
  // تلاش ۱: قالب دکمه‌ای با لینک پروفایل + کوئیک‌ریپلای
  let res = await send({
    attachment: { type: 'template', payload: { template_type: 'button', text, buttons: [{ type: 'web_url', url: gate.profile_url, title: gate.follow_btn_title }] } },
    quick_replies: qr,
  });
  // تلاش ۲: فقط کوئیک‌ریپلای
  if (!res.ok) res = await send({ text, quick_replies: qr });
  // تلاش ۳: متن ساده همراه لینک
  if (!res.ok) res = await send({ text: `${text}\n${gate.profile_url}` });
  if (!res.ok) {
    const body = await res.text().catch(() => '');
    throw new Error(`Graph ${res.status}: ${body.slice(0, 300)}`);
  }
}

// ─── منطق پاسخ به دایرکت ─────────────────────────────────────────
async function answerQuestion(senderId, text) {
  await sleep(humanDelay());
  const history = db.getHistory(ACCOUNT_KEY, senderId).slice(0, -1);
  const continued = history.some(m => m.role === 'model');
  // کد قطعه (حتی با ارقام فارسی) → جستجوی مستقیم؛ وگرنه جستجو با متن نرمال‌شده
  const code = extractProductCode(text);
  const ctx = await productContext(code || faToEnDigits(text)).catch(() => null);
  const augmented = ctx
    ? `${text}\n\n[اطلاعات واقعی سایت — فقط برای آگاهی تو؛ قیمت/لینک دقیق را سیستم جداگانه ضمیمه می‌کند پس خودت قیمت نگو:\n${ctx.geminiLine}]`
    : text;

  let sysPrompt = getPrompt();
  if (continued) sysPrompt += '\n\nاین گفتگو از قبل جاری است؛ بدون هیچ سلام و احوال‌پرسی مستقیم وارد جواب شو.';

  let reply = null;
  try {
    reply = await callGemini(sysPrompt, history, augmented);
  } catch (e) {
    console.error('[ig] gemini failed:', e.message);
    // اگر محصولی پیدا شده حداقل کارتش را بفرست؛ وگرنه پیام جایگزین مؤدبانه به‌جای سکوت
    reply = ctx ? '' : (continued ? 'الان کمی شلوغیم 🙏 لطفاً چند دقیقه دیگر دوباره پیام بدهید.' : 'سلام 🌸 الان کمی شلوغیم، لطفاً چند دقیقه دیگر دوباره پیام بدهید.');
  }

  // سلام تکراری در گفتگوی جاری حذف شود (توریق ایمنی کنار دستور پرامپت)
  if (continued && reply) {
    const stripped = reply.replace(/^(سلام( مجدد)?|درود)[^.!؟?\n]*[.!؟?,،\n]\s*/u, '').trim();
    if (stripped) reply = stripped;
  }

  // وقتی محصولی پیدا نشده، ادعای «لینک/قیمت را فرستادم» مدل حذف شود (ضدتوهم)
  if (!ctx && reply) {
    reply = reply.replace(/(قیمت و )?لینک[^؟?\n.!]{0,50}?فرستادم[ .\n!؟?]*/g, '').trim();
  }

  // کارت محصول (قیمت عمومی + لینک + دعوت به ثبت‌نام همکاری) همیشه توسط سیستم ضمیمه می‌شود
  if (ctx) reply = (reply ? reply + '\n\n' : '') + productCard(ctx);

  await sendIgText(senderId, reply);
  db.logMessage(ACCOUNT_KEY, senderId, 'model', reply);
  console.log(`[ig] -> ${senderId}: ${reply.slice(0, 80)}`);
}

// بعد از عبور از دروازه: موارد pending (لینک کلیدواژه / کارت محصول / سؤال) تحویل داده می‌شود
async function deliverAfterConfirm(senderId, gate, username) {
  if (username === undefined) username = (await fetchProfile(senderId).catch(() => null))?.username || null;
  // اول pendingها خوانده شوند، بعد وضعیت ok ثبت شود (ترتیب مهم است)
  const items = drainPending('ig:' + senderId).concat(username ? drainPending('u:' + username) : []);
  gateSet('ig:' + senderId, 'ok', []);
  // فقط آخرین سؤال جواب داده می‌شود تا کاربر با چند جواب پشت‌سرهم اذیت نشود
  const lastQ = items.map((it, i) => it.kind === 'question' ? i : -1).filter(i => i >= 0).pop();
  const deliver = items.filter((it, i) => it.kind !== 'question' || i === lastQ);
  await sleep(humanDelay());
  const hello = deliver.length ? gate.confirmed_text : gate.thanks_text;
  try {
    await sendIgText(senderId, hello);
    db.logMessage(ACCOUNT_KEY, senderId, 'model', hello);
  } catch (e) { console.error('[ig] gate hello send failed:', e.message); }
  for (const it of deliver) {
    await sleep(1500 + Math.floor(Math.random() * 2000));
    try {
      if (it.kind === 'kw-link' || it.kind === 'product-card') {
        await sendIgText(senderId, it.text);
        db.logMessage(ACCOUNT_KEY, senderId, 'model', it.text);
        console.log(`[ig] -> ${senderId}: pending ${it.kind} delivered ✅`);
      } else if (it.kind === 'question') {
        await answerQuestion(senderId, it.text);
      }
    } catch (e) { console.error(`[ig] pending ${it.kind} delivery failed:`, e.message); }
  }
}

async function handleMessage(senderId, text, quickPayload) {
  console.log(`[ig] ${senderId}: ${text.slice(0, 80)}`);
  db.logMessage(ACCOUNT_KEY, senderId, 'user', text);

  // ─── دروازه فالو برای کاربران جدید ───
  const gate = getGate();
  if (gate.enabled) {
    let status = gateStatus(senderId);
    if (status === 'none') {
      // گفتگوهای قدیمی (قبل از این قابلیت) معاف‌اند
      const hasHistory = db.getHistory(ACCOUNT_KEY, senderId).some(m => m.role === 'model');
      if (hasHistory) { gateSet('ig:' + senderId, 'ok', []); status = 'ok'; }
    }
    // توجه: فیلد is_user_follow_business متا نوسان دارد (همان کاربر را در فاصله چند دقیقه
    // یک‌بار true و یک‌بار false گفت) — پس بعد از اولین تأیید موفق، کاربر معتمد می‌ماند.
    // چک مجدد فقط اگر صریحاً در ig_gate.json با "recheck_followers": true فعال شود.
    if (status === 'ok' && gate.recheck_followers === true) {
      let prof = await fetchProfile(senderId).catch(() => null);
      if (prof && !prof.following) {
        await sleep(2500);
        prof = await fetchProfile(senderId).catch(() => null); // تأیید دوم در برابر نوسان API
      }
      if (prof && !prof.following) {
        gateSet('ig:' + senderId, 'pending', []);
        status = 'pending';
        console.log(`[ig] ${senderId}: unfollowed → back to gate`);
      }
    }
    if (status !== 'ok') {
      const confirmed = isGateConfirm(text, quickPayload, gate);
      // چک واقعی فالو از API متا — دکمه/متن «فالو کردم» به‌تنهایی کافی نیست
      const prof = await fetchProfile(senderId).catch(() => null);
      // اگر پروفایل خوانده نشد (خطای موقت API)، به تأیید خود کاربر اعتماد می‌کنیم
      const passed = prof ? prof.following : confirmed;
      // حرف‌های مربوط به دروازه (کردم، باشه و…) سؤال حساب نمی‌شوند
      const GATE_CHATTER = /^(کردم|فالو|فالو کردم|باشه|حتما|چشم|اوکی|ok|okay|done)[!💚🙏. ]*$/i;
      if (!confirmed && !GATE_CHATTER.test(text.trim())) pushPending('ig:' + senderId, { kind: 'question', text });
      if (passed) {
        console.log(`[ig] ${senderId}: follow verified ✅ (following=${prof?.following})`);
        await deliverAfterConfirm(senderId, gate, prof?.username);
      } else {
        console.log(`[ig] ${senderId}: NOT following yet (checked via API)`);
        await sleep(humanDelay());
        const ask = confirmed ? gate.still_not_following_text
          : (status === 'pending' ? gate.ask_text_short : gate.ask_text);
        await sendIgGateAsk(senderId, ask, gate);
        db.logMessage(ACCOUNT_KEY, senderId, 'model', ask);
        console.log(`[ig] -> ${senderId}: follow gate asked`);
      }
      return;
    }
  }

  await answerQuestion(senderId, text);
}

