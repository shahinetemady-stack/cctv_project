function matchKeyword(text, keywords) {
  const t = text.trim().toLowerCase();
  // اول طولانی‌ترین کلیدواژه‌ها تا «قیمت عمده» قبل از «قیمت» مچ شود
  for (const kw of Object.keys(keywords).sort((a, b) => b.length - a.length)) {
    if (t.includes(kw.toLowerCase())) return kw;
  }
  return null;
}

