async function handleComment(value) {
  const username = value.from?.username || '';
  const fromId = value.from?.id || '';
  const commentId = value.id;
  const text = (value.text || '').trim();
  if (!commentId || !text) return;
  // کامنت خودمان یا ریپلای‌هایمان را نادیده بگیر (جلوگیری از حلقه)
  if (OUR_USERNAMES.has(username) || OUR_IDS.has(fromId)) return;

  const keywords = getKeywords();
  const kw = matchKeyword(text, keywords);

  const now = Date.now();
  if (now - (lastCommentReply.get(username) || 0) < COMMENT_COOLDOWN_MS) {
    if (kw) console.log(`[ig-c] cooldown skip @${username}`);
  }

  // اگر کلمه کلیدی نبود، شاید کد قطعه باشد → کارت محصول (قیمت عمومی) در دایرکت
  if (!kw) {
    const code = extractProductCode(text);
    if (!code) return; // نه کلیدواژه نه کد قطعه — بی‌خیال
    if (now - (lastCommentReply.get(username) || 0) < COMMENT_COOLDOWN_MS) return;
    const p = await productContext(code).catch(() => null);
    if (!p) return; // چنین قطعه‌ای نداریم
    lastCommentReply.set(username, now);
    console.log(`[ig-c] @${username}: کد «${code}» → کارت محصول در DM`);
    db.logMessage(ACCOUNT_KEY, 'comment:' + username, 'user', text);
    await sleep(humanDelay());
    const dm = `سلام ${username ? '@' + username + ' ' : ''}🌟\nممنون از کامنتت. مشخصات قطعه‌ای که پرسیدی:\n\n` + productCard(p);
    const gate = getGate();
    if (gate.enabled && username) {
      // کارت بعد از تأیید فالو در دایرکت تحویل داده می‌شود
      pushPending('u:' + username, { kind: 'product-card', text: dm });
      await sendPrivateReply(commentId, gate.ask_text_comment);
      db.logMessage(ACCOUNT_KEY, 'comment:' + username, 'model', gate.ask_text_comment);
      console.log(`[ig-c] -> DM @${username} (follow gate) ✅`);
    } else {
      await sendPrivateReply(commentId, dm);
      db.logMessage(ACCOUNT_KEY, 'comment:' + username, 'model', dm);
      console.log(`[ig-c] -> DM @${username} (product card) ✅`);
    }
    return;
  }

  if (now - (lastCommentReply.get(username) || 0) < COMMENT_COOLDOWN_MS) return;
  lastCommentReply.set(username, now);

  const conf = keywords[kw];
  console.log(`[ig-c] @${username}: «${text.slice(0, 60)}» → کلیدواژه «${kw}»`);
  db.logMessage(ACCOUNT_KEY, 'comment:' + username, 'user', text);

  await sleep(humanDelay());

  // ۱) دایرکت با لینک (با دروازه فالو اگر فعال باشد — لینک بعد از تأیید «فالو کردم» می‌رسد)
  const gate = getGate();
  if (gate.enabled && username) {
    pushPending('u:' + username, { kind: 'kw-link', text: conf.dm_text });
    await sendPrivateReply(commentId, gate.ask_text_comment);
    db.logMessage(ACCOUNT_KEY, 'comment:' + username, 'model', gate.ask_text_comment);
    console.log(`[ig-c] -> DM @${username} (follow gate) ✅`);
  } else {
    await sendPrivateReply(commentId, conf.dm_text);
    db.logMessage(ACCOUNT_KEY, 'comment:' + username, 'model', conf.dm_text);
    console.log(`[ig-c] -> DM @${username} ✅`);
  }

  // ۲) ریپلای عمومی متنوع (اگر تعریف شده)
  if (Array.isArray(conf.public_replies) && conf.public_replies.length) {
    await sleep(1500 + Math.floor(Math.random() * 2500));
    const pub = pick(conf.public_replies).replaceAll('{user}', username ? '@' + username : '');
    await sendPublicReply(commentId, pub);
    console.log(`[ig-c] -> public reply @${username} ✅`);
  }
}

function processPayload(body) {
  if (body.object !== 'instagram') return;
  for (const entry of body.entry || []) {
    for (const ev of entry.messaging || []) {
      const senderId = ev.sender?.id;
      const msg = ev.message;
      if (!senderId || !msg || msg.is_echo || !msg.text) continue;
      handleMessage(senderId, msg.text.trim(), msg.quick_reply?.payload).catch(e => console.error('[ig] reply error:', e.message));
    }
    // رویدادهای کامنت (پست/ریلز) و کامنت لایو
    for (const ch of entry.changes || []) {
      if (ch.field !== 'comments' && ch.field !== 'live_comments') continue;
      handleComment(ch.value || {}).catch(e => console.error('[ig-c] error:', e.message));
    }
  }
}

const server = http.createServer((req, res) => {
  const url = new URL(req.url, `http://localhost:${PORT}`);

  if (req.method === 'GET' && url.pathname === '/webhook') {
    const mode = url.searchParams.get('hub.mode');
    const token = url.searchParams.get('hub.verify_token');
    const challenge = url.searchParams.get('hub.challenge');
    if (mode === 'subscribe' && token === VERIFY_TOKEN && challenge) {
      console.log('[ig] webhook verified ✅');
      res.writeHead(200, { 'Content-Type': 'text/plain' });
      res.end(challenge);
    } else {
      res.writeHead(403); res.end('forbidden');
    }
    return;
  }

  if (req.method === 'POST' && url.pathname === '/webhook') {
    let raw = '';
    req.on('data', c => { raw += c; if (raw.length > 1e6) req.destroy(); });
    req.on('end', () => {
      res.writeHead(200, { 'Content-Type': 'text/plain' });
      res.end('EVENT_RECEIVED'); // جواب سریع به متا، پردازش async
      try { processPayload(JSON.parse(raw)); } catch (e) { console.error('[ig] bad payload:', e.message); }
    });
    return;
  }

  if (req.method === 'GET' && url.pathname === '/health') {
    res.writeHead(200); res.end('ok');
    return;
  }

  res.writeHead(404); res.end('not found');
});

server.listen(PORT, '127.0.0.1', () => console.log(`[ig] webhook listening on 127.0.0.1:${PORT}`));
